<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Research Companion</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex" style="min-height:100vh;">
        <nav class="bg-light border-end p-3" style="width:220px;">
            <a class="d-block mb-4 fw-bold text-decoration-none" href="/">Research Companion</a>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Intake/Index">New research profile</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Library/Index">Literature library</a></li>
                </ul>
                <hr />
                <form method="post" action="/Account/Logout">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Log out (@User.Identity!.Name)</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline-primary btn-sm w-100 mb-2" href="/Account/Login">Log in</a>
                <a class="btn btn-primary btn-sm w-100" href="/Account/Register">Register</a>
            }
        </nav>
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
