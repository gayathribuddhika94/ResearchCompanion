@page
@model ResearchCompanion.Pages.Account.RegisterModel

<h3>Create an account</h3>
<div class="col-md-6">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label">Full name</label>
            <input asp-for="Input.FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Which best describes you?</label>
            <select asp-for="Input.ResearcherType" class="form-select">
                <option>Undergraduate</option>
                <option>Postgraduate (MSc/MPhil)</option>
                <option>PhD candidate</option>
                <option>Industry / R&amp;D professional</option>
                <option>Independent researcher</option>
                <option>Other</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Register</button>
    </form>
</div>
